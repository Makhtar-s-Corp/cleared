# systemd user unit, installed by serve/install.sh: writes the dashboard
# again from the ledger. Scripts only, no model is started.
[Unit]
Description=Orchestration dashboard (refresh)

[Service]
# orca and the CLIs are installed in the home of the user: a unit does not get
# that folder on its PATH by itself.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# One locale the host has: the session that started the units may carry one
# it has not, and every shell would say so on every line.
# The project this copy of the tool works on, written by install.sh.
Environment=ORCH_REPO=@ORCH_REPO@
Environment=LANG=C.UTF-8
Type=oneshot
ExecStart=@ORCH_HOME@/dashboard.sh
