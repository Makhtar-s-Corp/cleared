# systemd user unit, installed by serve/install.sh: serves the one page of
# the dashboard on the Tailscale address of the server, and refuses any peer
# that is not a machine of the Tailscale network (serve-dashboard.mjs). No
# container, no proxy in front.
[Unit]
Description=Cleared dashboard (static page, Tailscale only)

[Service]
# orca and the CLIs are installed in the home of the user: a unit does not get
# that folder on its PATH by itself.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# One locale the host has: the session that started the units may carry one
# it has not, and every shell would say so on every line.
# The project this copy of the tool works on, written by install.sh.
Environment=ORCH_REPO=@ORCH_REPO@
Environment=LANG=C.UTF-8
# The old page is replaced by the app: every request to the page is sent there.
Environment=CLEARED_APP_URL=http://@BIND@:@APP_PORT@/
ExecStart=/usr/bin/node @ORCH_HOME@/serve/serve-dashboard.mjs @BIND@ @PORT@ @DASHBOARD_DIR@/index.html
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
