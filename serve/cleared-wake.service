# systemd user unit, installed by serve/install.ts: one wake. Scripts only,
# no model.
[Unit]
Description=Cleared: the wake

[Service]
# The CLIs (gh among them) may be installed in the home of the user: a unit
# does not get that folder on its PATH by itself.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# One locale the host has: the session that started the units may carry one
# it has not, and every shell would say so on every line.
# The project this copy of the tool works on, written by install.ts.
Environment=ORCH_REPO=@ORCH_REPO@
Environment=LANG=C.UTF-8
Type=oneshot
ExecStart=@ORCH_HOME@/wake.ts
