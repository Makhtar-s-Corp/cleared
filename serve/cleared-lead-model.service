# systemd user unit, installed by serve/install.sh: checked each time the
# timer of the wakes is started, by hand too. The timer does not start when
# the model of the project lead is not the one decided last.
[Unit]
Description=Cleared: the model of the project lead is the one decided

[Service]
# orca and the CLIs are installed in the home of the user: a unit does not get
# that folder on its PATH by itself.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# One locale the host has: the session that started the units may carry one
# it has not, and every shell would say so on every line.
# The project this copy of the tool works on, written by install.sh.
Environment=ORCH_REPO=@ORCH_REPO@
Environment=LANG=C.UTF-8
Type=oneshot
ExecStart=@ORCH_HOME@/check-lead-model.sh
