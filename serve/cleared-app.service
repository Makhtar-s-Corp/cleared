# systemd user unit, installed by serve/install.sh: the Cleared app (Cockpit).
# It listens on the Tailscale address only, refuses any peer outside the
# allowed ranges, and wants an access token kept outside the repository. It
# also holds the human's own tracker accesses ([app] human_credentials_dir) to
# write the three gestures of the human: run it as the app's service account,
# never as the agents' account.
[Unit]
Description=Cleared app (Tailscale only; writes only the human's three gestures)

[Service]
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=ORCH_REPO=@ORCH_REPO@
Environment=LANG=C.UTF-8
ExecStart=/usr/bin/node @ORCH_HOME@/cleared app --bind @BIND@ --port @APP_PORT@
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
