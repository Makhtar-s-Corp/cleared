# systemd user unit, installed by serve/install.sh: one wake of the project
# lead. Scripts only; a model starts only when something moved.
[Unit]
Description=Orchestration: wake of the project lead

[Service]
# orca and the CLIs are installed in the home of the user: a unit does not get
# that folder on its PATH by itself.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# One locale the host has: the session that started the units may carry one
# it has not, and every shell would say so on every line.
Environment=LANG=C.UTF-8
Type=oneshot
ExecStart=@ORCH_HOME@/wake.sh
