# systemd user unit, installed by serve/install.sh: reads the session logs of
# the old way of working into the ledger, so that both can be compared.
[Unit]
Description=Orchestration: old sessions into the ledger

[Service]
# orca and the CLIs are installed in the home of the user: a unit does not get
# that folder on its PATH by itself.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Type=oneshot
ExecStart=/usr/bin/node --no-warnings @ORCH_HOME@/import-legacy.mjs --days 3
