# systemd user unit, installed by serve/install.sh: serves the one page of
# the dashboard on the Tailscale address of the server, and refuses any peer
# that is not a machine of the Tailscale network (serve-dashboard.mjs). No
# container, no proxy in front.
[Unit]
Description=Orchestration dashboard (static page, Tailscale only)

[Service]
# orca and the CLIs are installed in the home of the user: a unit does not get
# that folder on its PATH by itself.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/node @ORCH_HOME@/serve/serve-dashboard.mjs @BIND@ @PORT@ @DASHBOARD_DIR@/index.html
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
