#!/usr/bin/env node
import { mkdirSync, readFileSync } from 'node:fs';
import { spawnSync } from 'node:child_process';
import { join } from 'node:path';
import { loadConf, stateDir } from './lib/conf.mjs';
import { createTracker } from './lib/tracker/contract.mjs';

const [area, action, ...args] = process.argv.slice(2);
if (area === 'status') {
  if ([action, ...args].filter(Boolean).some((flag) => !['--json', '--reap'].includes(flag))) {
    console.error('usage: cleared status [--json] [--reap]'); process.exit(64);
  }
  const result = spawnSync(process.execPath, [new URL('./lib/heartbeat.mjs', import.meta.url).pathname,
    'status', ...[action, ...args].filter(Boolean)], { stdio: 'inherit' });
  process.exit(result.status ?? 1);
}
if (area === 'app') {
  const result = spawnSync(process.execPath, [new URL('./app/main.mjs', import.meta.url).pathname, ...[action, ...args].filter(Boolean)], { stdio: 'inherit' });
  process.exit(result.status ?? 1);
}
if (area === 'rollback') {
  if (!action || action.startsWith('--')) { console.error('usage: cleared rollback <ticket> [--yes] [--force-with-migrations] [--approval-comment ID]'); process.exit(64); }
  mkdirSync(stateDir(), { recursive: true });
  const result = spawnSync('flock', ['-x', '-w', '120', join(stateDir(), 'merge.lock'), process.execPath,
    new URL('./lib/release.mjs', import.meta.url).pathname, 'rollback', action, ...args], { stdio: 'inherit' });
  process.exit(result.status ?? 1);
}
if (area !== 'ticket' || !['new', 'show', 'comment', 'move'].includes(action)) {
  console.error('usage: cleared ticket new <title> [body file] | show <id> | comment <id> <body file> | move <id> <status> | rollback <ticket> [--yes]');
  process.exit(64);
}
const conf = loadConf();
if (conf.sections.tracker?.adapter !== 'local') {
  console.error('cleared ticket commands require [tracker] adapter = local');
  process.exit(2);
}
if (!process.env.CLEARED_STATE_DIR && !process.env.ORCH_STATE_DIR) {
  console.error('cleared ticket commands require CLEARED_STATE_DIR set to the shared state directory used by the Cleared service');
  process.exit(2);
}
const tracker = createTracker(conf);
try {
  let result;
  if (action === 'new') result = tracker.createTicket({ title: args[0], body: args[1] ? readFileSync(args[1], 'utf8') : '' });
  else if (action === 'show') {
    const ticket = tracker.getTicket(args[0]);
    if (!ticket) throw new Error(`No such ticket: ${args[0]}`);
    result = { ...ticket, comments: tracker.comments(args[0]), history: tracker.history(args[0]) };
  }
  else if (action === 'comment') result = tracker.comment(args[0], readFileSync(args[1], 'utf8'));
  else result = tracker.moveTicket(args[0], args[1]);
  console.log(JSON.stringify(result, null, 2));
} catch (error) { console.error(`cleared: ${error.message}`); process.exitCode = 1; }
finally { tracker.close?.(); }
