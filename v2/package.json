{
  "name": "cleared-v2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cleared v2 core service. TypeScript run by Node's type stripping, without a build step.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "app": "node app/main.ts",
    "user": "node src/cli/user.ts",
    "setup": "node src/cli/setup.ts",
    "test": "node --test \"test/**/*.test.ts\" \"app/test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p app",
    "guard": "node scripts/guard.ts",
    "doctor": "node scripts/doctor.ts",
    "notify": "node src/cli/notify.ts"
  },
  "devDependencies": {
    "@ag-ui/core": "1.0.3",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
