{
  "name": "cleared-v2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cleared v2 core service. TypeScript run by Node's type stripping, without a build step; the app's React front end is built by Vite.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "build": "vite build --config app/web/vite.config.ts",
    "preapp": "npm run build",
    "app": "node app/main.ts",
    "user": "node src/cli/user.ts",
    "setup": "node src/cli/setup.ts",
    "pretest": "npm run build",
    "test": "node --test \"test/**/*.test.ts\" \"app/test/**/*.test.ts\" && vitest run --config app/web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p app && tsc --noEmit -p app/web",
    "guard": "node scripts/guard.ts",
    "doctor": "node scripts/doctor.ts",
    "notify": "node src/cli/notify.ts"
  },
  "devDependencies": {
    "@ag-ui/client": "1.0.2",
    "@ag-ui/core": "1.0.3",
    "@copilotkit/react-core": "1.77.2",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-popover": "1.2.0",
    "@radix-ui/react-slot": "1.4.0",
    "@radix-ui/react-toggle": "1.1.19",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rxjs": "7.8.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "zod": "4.6.5"
  },
  "overrides": {
    "zod": "4.6.5"
  },
  "scarfSettings": {
    "enabled": false
  }
}
