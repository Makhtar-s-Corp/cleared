{
  "name": "cleared-v2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cleared v2 core service. TypeScript run by Node's type stripping, without a build step.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "guard": "node scripts/guard.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
